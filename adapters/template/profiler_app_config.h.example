#ifndef PROFILER_APP_CONFIG_H
#define PROFILER_APP_CONFIG_H
/* Copy into your application as profiler_app_config.h and replace these tokens
 * with the SDK/application constants for your actual stack memory layout.
 * Select the device header through your board layer (or compiler definition). */
#define PROFILER_STACK_BASE YOUR_STACK_BASE
#define PROFILER_STACK_BYTES YOUR_STACK_BYTES
/* For multiple regions, replace both definitions above with:
 * #define PROFILER_STACK_REGIONS {{MSP_RAM_BASE, MSP_RAM_BYTES}, {PSP_RAM_BASE, PSP_RAM_BYTES}}
 */
#endif
